# Copie para .env (não versionado). Os scripts carregam este arquivo automaticamente.
# Nenhuma chave de API é necessária: o LLM do módulo GenAI é open source e roda localmente.

# GenAI: modelo do Hugging Face (padrão Qwen/Qwen3-1.7B). Alternativas:
#   CITIZENTECH_HF_MODEL=Qwen/Qwen3-4B      (melhor e ~2,5x mais lento)
#   CITIZENTECH_HF_MODEL=Qwen/Qwen3-0.6B    (mais rápido e bem menos preciso)
# CITIZENTECH_HF_MODEL=Qwen/Qwen3-1.7B

# IoT (opcional): base dos tópicos MQTT (igual ao firmware) e alertas no Telegram
# MQTT_BASE=fiap/citizentech/gohorse-gs2026
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# GenAI: 1 = simula o envio do alerta MQTT (sem rede)
# CITIZENTECH_MQTT_DRY_RUN=1
